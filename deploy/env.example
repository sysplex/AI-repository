# M0-T08 环境变量模板 —— 与 `docs/tasks/M0/CONTRACTS.md §10` 一一对应。
# 用法：cp deploy/env.example deploy/.env 后按注释替换占位值。
# 切勿把填好的 deploy/.env 提交到仓库（.gitignore 已忽略 .env / .env.*）。

# ---------------- 应用（可选）----------------
# local / ci / staging / production
APP_ENV=local
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# true 输出 JSON 结构化日志；本地调试可设 false
LOG_JSON=true
# 允许跨域的前端源：JSON 数组或逗号分隔
CORS_ORIGINS=["http://localhost:8080"]
# /metrics 是否开放（关闭时该路由返回 404）
METRICS_ENABLED=true
# /docs 与 /openapi.json 是否开放；production 下不显式设置时默认关闭
DOCS_ENABLED=true

# ---------------- M1 认证（可选，全部有默认值）----------------
# access 令牌有效期（秒），必须为正整数；JWT 算法固定 HS256
ACCESS_TOKEN_TTL_SECONDS=900
# 刷新令牌有效期（秒），必须为正整数
REFRESH_TOKEN_TTL_SECONDS=2592000
# 密码重置令牌有效期（秒），必须为正整数
PASSWORD_RESET_TTL_SECONDS=3600
# 登录失败限流：窗口内最大失败次数与窗口长度（秒），均为正整数
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# 每用户每日 AI 配额（Q4 已裁决：默认 20；M5 扣减逻辑落地前 /me/usage 只读）；0 表示禁用，不得为负
AI_DAILY_QUOTA=20

# ---------------- 邮件投递（Q3 已裁决：Gmail / Outlook SMTP，可选）----------------
# 以下配置默认全部注释，保持 M1 结项时的行为：APP_ENV=ci 用内存实现、
# local 未启用时用日志实现（scripts/m1_demo.py 依赖日志读取一次性令牌）。
# 需要真实发信时：取消下面 7 行注释，并把 CHANGE_ME_* 换成真实值。
#   Gmail   ：开启两步验证后生成「应用专用密码 App Password」，填 SMTP_USER=完整 Gmail 地址、
#             SMTP_PASSWORD=16 位应用密码（不是账号登录密码）。
#   Outlook ：SMTP_PROVIDER=outlook，SMTP_USER=完整 Microsoft 365 邮箱地址；
#             租户需允许「已验证 SMTP AUTH」，否则 login 会被服务端拒绝。
# 两者均为 STARTTLS（587）。自建/中继用 SMTP_PROVIDER=custom 并显式给 SMTP_HOST。
# 安全：SMTP_PASSWORD 属于密钥，绝不提交到仓库；填好的 deploy/.env 已在 .gitignore 中。
# 半配置（只填 USER 不填 PASSWORD 等）会在启动时报错，避免「以为在发信、其实在写日志」。
# APP_ENV=ci 时即使配置了 SMTP 也强制使用内存实现，CI 绝不外发邮件。
# SMTP_PROVIDER=gmail
# SMTP_USER=CHANGE_ME_your_address@gmail.com
# SMTP_PASSWORD=CHANGE_ME_app_password
# SMTP_FROM=
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_TIMEOUT_SECONDS=10
# 自建 SMTP 时额外取消注释（同时把 SMTP_PROVIDER 改为 custom）：
# SMTP_HOST=smtp.example.internal

# ---------------- 必填 ----------------
# compose 场景下 DATABASE_URL 由 docker-compose.yml 用 POSTGRES_USER/PASSWORD/DB
# 针对服务名 postgres 自动拼装，此处无需填密码；仅当绕过 compose 直连时才需要补全。
DATABASE_URL=postgresql+asyncpg://stockpilot@postgres:5432/stockpilot
# 同理，compose 会覆盖为 redis://redis:6379/0
REDIS_URL=redis://redis:6379/0
# 必填，>= 32 字符随机串；生成方式：openssl rand -hex 32
# 下方为占位值，上线前必须替换（泄露会导致会话/令牌可伪造）
SECRET_KEY=CHANGE_ME_please_replace_with_32_plus_random_chars

# ---------------- 测试（T10）----------------
# 仅测试用；留空表示不跑真实库用例（无 docker 时自动 skip）
TEST_DATABASE_URL=

# ---------------- Postgres 容器 ----------------
# 与 DATABASE_URL 的账号密码库名保持一致；这些值同时用于 postgres 服务初始化
POSTGRES_USER=stockpilot
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=stockpilot

# ---------------- Nginx ----------------
# 唯一对外暴露的端口（宿主端口 -> 容器 80）
NGINX_PORT=8080
